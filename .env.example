# ===========================================
# TasksCatt Environment Configuration
# ===========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/taskscatt?schema=public"

# Backend
BACKEND_PORT=5001
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:5001"
NEXT_PUBLIC_WS_URL="ws://localhost:5001"

# Node Environment
NODE_ENV="development"
